///$tab Main
SET ThousandSep=',';
SET DecimalSep='.';
SET MoneyThousandSep=',';
SET MoneyDecimalSep='.';
SET MoneyFormat='€#,##0.00;-€#,##0.00';
SET TimeFormat='hh:mm:ss';
SET DateFormat='DD/MM/YYYY';
SET TimestampFormat='DD/MM/YYYY hh:mm:ss[.fff]';
SET FirstWeekDay=6;
SET BrokenWeeks=0;
SET ReferenceDay=4;
SET FirstMonthOfYear=1;
SET CollationLocale='en-IE';
SET CreateSearchIndexOnReload=1;
SET MonthNames='Jan;Feb;Mar;Apr;May;Jun;Jul;Aug;Sep;Oct;Nov;Dec';
SET LongMonthNames='January;February;March;April;May;June;July;August;September;October;November;December';
SET DayNames='Mon;Tue;Wed;Thu;Fri;Sat;Sun';
SET LongDayNames='Monday;Tuesday;Wednesday;Thursday;Friday;Saturday;Sunday';
SET NumericalAbbreviation='3:k;6:M;9:G;12:T;15:P;18:E;21:Z;24:Y;-3:m;-6:μ;-9:n;-12:p;-15:f;-18:a;-21:z;-24:y';

///$tab 5_Parametres
// =====================================================================
// TED - Délais de publication des avis  |  version 2 (refactoring)
// Principe : (1) MESURER le délai réel pour chaque avis,
//            (2) déterminer le SCÉNARIO (ASAP / PPD),
//            (3) appliquer le CONTRÔLE propre au scénario,
//            (4) appliquer les EXCEPTIONS sans jamais écraser la mesure.
// Tous les paramètres sont ici : aucune valeur "en dur" plus bas.
// =====================================================================

SET vSLA_Days = 5;                       // délai légal max en mode ASAP (jours calendaires)
SET vYearMin  = 2024;                    // première année de publication analysée
LET vYearMax  = Year(Today());           // dernière année : automatique (plus de 2026 en dur)
SET vTZ_Place = 'Brussels';              // export_logs.created_on est en UTC -> conversion heure de Bruxelles (gère l'heure d'été)
//SET vQVD_Notices = 'lib://QS_Data (welcome_massseb)/eFormsData_2025.qvd';
SET vQVD_Notices = 'lib://AttachedFiles/QVD_Notices.qvd'; 
SET vUseExportEndForRestart = 1;         // 1 = utiliser aussi ojs_release.exported_on comme fin de fenêtre de redémarrage (vérifier son fuseau avant)

// Conversions robustes : accepte un numérique Qlik ou un texte ISO, renvoie un numérique (Null si illisible)
SET fTS   = Alt(If(IsNum($1), $1), Timestamp#($1, 'YYYY-MM-DD hh:mm:ss.ffffff'), Timestamp#($1, 'YYYY-MM-DD hh:mm:ss.fff'), Timestamp#($1, 'YYYY-MM-DD hh:mm:ss'));
SET fDate = Alt(If(IsNum($1), Floor($1)), Floor(Date#(Left($1, 10), 'YYYY-MM-DD')), Floor(Date#(Left($1, 10), 'DD/MM/YYYY')));

LET vReloadTime = Now();

reload_eNotices2:
LOAD * INLINE [
LoadTime
$(vReloadTime)
];

///$tab 10_Calendrier de production
// ---------------------------------------------------------------------
// 1.1 Releases OJS et démarrages d'export
// ---------------------------------------------------------------------

/*
LIB CONNECT TO 'OP_AWS_TEDMON22';

OJS_Release:
LOAD
    ojs_release_id,
    Date($(fDate(publication_date)))   AS ojs_publication_date,
    Timestamp($(fTS(exported_on)))     AS ojs_exported_on;        // fin d'export (fuseau à confirmer)
SQL SELECT ojs_release_id, exported_on, publication_date
FROM tedmon22_database.ojs_release;

Export_Log:
LOAD
    ojs_release_id,
    Timestamp(ConvertToLocalTime($(fTS(created_on)), '$(vTZ_Place)')) AS export_start_local;
SQL SELECT ojs_release_id, created_on
FROM tedmon22_database.export_logs;

DisConnect;
*/
OJS_Release:
LOAD
    ojs_release_id,
    ojs_publication_date,
    ojs_exported_on
 //   Timestamp(ConvertToLocalTime(ojs_exported_on, '$(vTZ_Place)')) AS ojs_exported_on
FROM [lib://AttachedFiles/OJS_Release.qvd]
(qvd);

Export_Log:
LOAD
    ojs_release_id,
    export_start_local
FROM [lib://AttachedFiles/Export_Log.qvd]
(qvd);


DisConnect;

// Tous les démarrages sont conservés : premier, dernier, nombre 1 ou plus (=> détection des redémarrages)
LEFT JOIN (OJS_Release)
LOAD
    ojs_release_id,
    Timestamp(Min(export_start_local)) AS export_first_start,
    Timestamp(Max(export_start_local)) AS export_last_start,
    Count(export_start_local)          AS export_start_count
RESIDENT Export_Log
GROUP BY ojs_release_id;

DROP TABLE Export_Log;

// --------------------------------------------------------------------------------------
// 1.2 Plan de production : 1 ligne par date de publication pour éviter doublons plus loin
// --------------------------------------------------------------------------------------
Production_Calendar:
LOAD
    ojs_publication_date                                  AS plan_pub_date,
    FirstSortedValue(ojs_release_id, export_first_start)  AS plan_ojs_release_id,
    Count(ojs_release_id)                                 AS plan_release_count,
    Timestamp(Min(export_first_start))                    AS plan_export_first_start,
    Timestamp(Max(export_last_start))                     AS plan_export_last_start,
    Sum(export_start_count)                               AS plan_export_start_count,
    Timestamp(Max(ojs_exported_on))                       AS plan_exported_on
RESIDENT OJS_Release
WHERE NOT IsNull(ojs_publication_date)
GROUP BY ojs_publication_date;

DROP TABLE OJS_Release;

Map_IsPubDate:       MAPPING LOAD Num(plan_pub_date), 1                            RESIDENT Production_Calendar;
Map_Plan_FirstStart: MAPPING LOAD Num(plan_pub_date), Num(plan_export_first_start) RESIDENT Production_Calendar;
Map_Plan_LastStart:  MAPPING LOAD Num(plan_pub_date), Num(plan_export_last_start)  RESIDENT Production_Calendar;
Map_Plan_ExportedOn: MAPPING LOAD Num(plan_pub_date), Num(plan_exported_on)        RESIDENT Production_Calendar;
Map_Plan_StartCount: MAPPING LOAD Num(plan_pub_date), plan_export_start_count      RESIDENT Production_Calendar;

// ---------------------------------------------------------------------
// 1.3 "Prochaine date de publication" pour chaque jour du calendrier
//     sert à recaler une Preferred Publication Date (PPD) qui n'est pas un jour de publication
// ---------------------------------------------------------------------
Tmp_Bounds:
LOAD Max(plan_pub_date) AS b_max RESIDENT Production_Calendar;
LET vCalStart = Num(MakeDate($(vYearMin) - 1, 1, 1));
LET vCalEnd   = Num(Peek('b_max', 0, 'Tmp_Bounds'));
DROP TABLE Tmp_Bounds;

Tmp_Cal:
LOAD Date($(vCalStart) + IterNo() - 1) AS cal_date
AUTOGENERATE 1
WHILE $(vCalStart) + IterNo() - 1 <= $(vCalEnd);

LEFT JOIN (Tmp_Cal)
LOAD plan_pub_date AS cal_date, plan_pub_date AS cal_pub_date
RESIDENT Production_Calendar;


Tmp_CalNext:
NoConcatenate
LOAD
    cal_date,
    Date(Alt(cal_pub_date, Peek('cal_next_pub_date'))) AS cal_next_pub_date   // remplissage vers l'arrière
RESIDENT Tmp_Cal
ORDER BY cal_date DESC;

DROP TABLE Tmp_Cal;

Map_NextPubDate:
MAPPING LOAD Num(cal_date), Num(cal_next_pub_date)
RESIDENT Tmp_CalNext
WHERE NOT IsNull(cal_next_pub_date);

DROP TABLE Tmp_CalNext;

///$tab 20_Reception Notices
// ---------------------------------------------------------------------
// 2.1 Date/heure réelle de réception : audit_log NOTICE_RECEIVED
//     Règle explicite : PREMIÈRE réception (Min) si plusieurs événements
// ---------------------------------------------------------------------
/*
LIB CONNECT TO 'OP_AWS_TEDMON22';

Audit_Reception:
LOAD
    notice_id            AS business_notice_id,
    $(fTS(logged_on))    AS logged_on_num;
SQL SELECT notice_id, logged_on
FROM tedmon22_database.audit_log
WHERE category = 'NOTICE_RECEIVED';

DisConnect;
*/
Audit_Reception:
LOAD
    business_notice_id,
    logged_on_num
FROM [lib://AttachedFiles/Audit_Log.qvd]
(qvd);


Tmp_Reception:
LOAD
    business_notice_id,
    Min(logged_on_num)   AS rec_first,
    Count(logged_on_num) AS rec_count
RESIDENT Audit_Reception
GROUP BY business_notice_id;

DROP TABLE Audit_Reception;


Map_Reception:      MAPPING LOAD business_notice_id, rec_first RESIDENT Tmp_Reception;
Map_ReceptionCount: MAPPING LOAD business_notice_id, rec_count RESIDENT Tmp_Reception;
DROP TABLE Tmp_Reception;

// ---------------------------------------------------------------------
// 2.2 Avis publiés
// ---------------------------------------------------------------------
Notices_Src:
// LOAD
//     business_notice_id_TM22                                   AS business_notice_id,
//     publication_number_TM22,
//     FINAL_SOURCE,
//     explanation,
//     email_address_source_UIorAPI_EN2,
//     eSender_author_email_EN2,
//     main_buyer_name_TM22,
//     FINAL_SDK,
//     COUNTRY_LABEL_STAT,
//     type_TM22,
//     main_publication_TM22                                     AS main_publication,
//     status_TM22,
//     status_TM22_Reel,
//     'eForm'                                                   AS source,
//     notice_check_in_date_TM22,
//     publication_date_preferred_TM22                           AS ppd_raw,
//     Date($(fDate(publication_date_TM22)))                     AS actual_pub_date,
//     Date($(fDate(publication_date_preferred_TM22)))           AS ppd_requested_date,
//     If(Len(Trim(publication_date_preferred_TM22)) > 0, 1, 0)  AS has_ppd,
//     $(fTS(notice_check_in_date_TM22))                         AS checkin_num
// FROM [$(vQVD_Notices)] (qvd)
// WHERE status_TM22_Reel = 'Published'
//   AND Year_publication_TM22 >= $(vYearMin)
//   AND Year_publication_TM22 <= $(vYearMax);


LOAD
    business_notice_id_TM22                                   AS business_notice_id,
    publication_number_TM22,
    FINAL_SOURCE,
    explanation,
    email_address_source_UIorAPI_EN2,
    eSender_author_email_EN2,
    main_buyer_name_TM22,
    FINAL_SDK,
    COUNTRY_LABEL_STAT,
    type_TM22,
    main_publication                                          AS main_publication,
    status_TM22,
    status_TM22_Reel,
    source 													  AS source,
    notice_check_in_date_TM22,
    publication_date_preferred_TM22                           AS ppd_raw,
    Date($(fDate(publication_date_TM22)))                     AS actual_pub_date,
    Date($(fDate(publication_date_preferred_TM22)))           AS ppd_requested_date,
    If(Len(Trim(publication_date_preferred_TM22)) > 0, 1, 0)  AS has_ppd,
    $(fTS(notice_check_in_date_TM22))                         AS checkin_num
FROM [lib://AttachedFiles/Notices_retard_extrait.qvd]
(qvd)
WHERE status_TM22_Reel = 'Published'
; 
  

// Réception : audit_log, à défaut check-in (cas réinjection / bug 28/01/2025) 
Notices_1:
NoConcatenate
LOAD *,
    Timestamp(Alt(rec_audit_num, checkin_num)) AS reception_ts,
    If(NOT IsNull(rec_audit_num), 'AUDIT_LOG',
       If(NOT IsNull(checkin_num), 'CHECK_IN_FALLBACK', 'MISSING')) AS reception_source;
LOAD *,
    ApplyMap('Map_Reception', business_notice_id, Null())  AS rec_audit_num,
    ApplyMap('Map_ReceptionCount', business_notice_id, 0)  AS reception_event_count
RESIDENT Notices_Src;

DROP TABLE Notices_Src;
DROP FIELDS rec_audit_num, checkin_num FROM Notices_1;

///$tab 30_Premier export possible
// ---------------------------------------------------------------------
// IntervalMatch : chaque réception est placée entre deux démarrages d'export
//   ]démarrage précédent ; démarrage suivant]  -> premier export qui pouvait prendre la notice
//
// IntervalMatch est INCLUSIF aux deux bornes : la borne basse est décalée d'une seconde
// pour que les intervalles ne se chevauchent pas (=> pas de doublons).
// ---------------------------------------------------------------------
Export_Intervals:
LOAD
    plan_pub_date                                         AS iv_pub_date,
    plan_export_first_start                               AS iv_next_export_start,
    Num(plan_export_first_start)                          AS iv_upper,
    If(RowNo() = 1, 0, Peek('iv_upper') + 1/86400000)    AS iv_lower
RESIDENT Production_Calendar
WHERE NOT IsNull(plan_export_first_start)
ORDER BY plan_export_first_start ASC;

Tmp_Rec:
LOAD business_notice_id, Num(reception_ts) AS rec_num
RESIDENT Notices_1
WHERE NOT IsNull(reception_ts);

Tmp_IM:
IntervalMatch (rec_num)
LOAD iv_lower, iv_upper RESIDENT Export_Intervals;

LEFT JOIN (Tmp_IM)
LOAD iv_lower, iv_upper, iv_pub_date, iv_next_export_start RESIDENT Export_Intervals;

LEFT JOIN (Tmp_Rec)
LOAD rec_num, iv_pub_date, iv_next_export_start RESIDENT Tmp_IM;

Map_EarliestPub: MAPPING LOAD business_notice_id, Num(iv_pub_date)          RESIDENT Tmp_Rec;
Map_NextExport:  MAPPING LOAD business_notice_id, Num(iv_next_export_start) RESIDENT Tmp_Rec;

DROP TABLES Tmp_IM, Tmp_Rec, Export_Intervals;

///$tab 40_Scenarios
// ---------------------------------------------------------------------
// 4.1 Dates de référence + détection automatique des redémarrages d'export
// ---------------------------------------------------------------------
Notices_2:
NoConcatenate
LOAD *,
    Date(If(late_inclusion_flag = 1, actual_pub_date, earliest_pub_date_theoretical)) AS earliest_pub_date;
LOAD *,
    // Avis reçu APRÈS le 1er démarrage mais publié dans ce même OJS => il a été pris par un redémarrage
    If(actual_pub_date < earliest_pub_date_theoretical
       AND reception_ts > actual_export_first_start
       AND reception_ts <= RangeMax(actual_export_last_start, If($(vUseExportEndForRestart) = 1, actual_exported_on)),
       1, 0)                                                                       AS late_inclusion_flag;
LOAD *,
    Date(ApplyMap('Map_EarliestPub', business_notice_id, Null()))                  AS earliest_pub_date_theoretical,
    Timestamp(ApplyMap('Map_NextExport', business_notice_id, Null()))              AS next_export_start,
    Timestamp(ApplyMap('Map_Plan_FirstStart', Num(actual_pub_date), Null()))       AS actual_export_first_start,
    Timestamp(ApplyMap('Map_Plan_LastStart',  Num(actual_pub_date), Null()))       AS actual_export_last_start,
    Timestamp(ApplyMap('Map_Plan_ExportedOn', Num(actual_pub_date), Null()))       AS actual_exported_on,
    ApplyMap('Map_Plan_StartCount', Num(actual_pub_date), 0)                       AS actual_export_start_count,
    ApplyMap('Map_IsPubDate', Num(actual_pub_date), 0)                             AS actual_pub_date_in_plan,
    If(has_ppd = 1, Date(ApplyMap('Map_NextPubDate', Num(ppd_requested_date), Null()))) AS ppd_next_pub_date,
    If(has_ppd = 1, ApplyMap('Map_IsPubDate', Num(ppd_requested_date), 0))         AS ppd_is_pub_date
RESIDENT Notices_1;

DROP TABLE Notices_1;

// ---------------------------------------------------------------------
// 4.2 Scénario, MESURE (toujours calculée) et CONTRÔLE (selon scénario)
//   A  = ASAP (pas de PPD)                       -> contrôle 5 jours
//   B1 = PPD valide (jour de publication atteignable) -> publié à la PPD ?
//   B2 = PPD hors calendrier -> recalée sur la prochaine date de publication -> contrôle 5j
//   B3 = PPD trop tôt (passée ou après le dernier export possible) -> référence = 1re date possible
//   X  = données insuffisantes -> TO CHECK (jamais classé IN TIME par défaut)
// ---------------------------------------------------------------------
Notices_3:
NoConcatenate
LOAD *,
    If(scenario_code = 'A' OR scenario_code = 'B3', legal_check,
       If(WildMatch(scenario_code, 'B1', 'B2'),
          Pick(Match(ppd_check, 'ON REQUESTED DATE', 'AFTER REFERENCE DATE', 'EARLY'), 'IN TIME', 'OVERDUE', 'EARLY'),
          'UNDETERMINED'))                                                         AS control_result_raw;
LOAD *,
    If(scenario_code <> 'X',
       If(publication_delay_calendar_days <= $(vSLA_Days), 'IN TIME', 'OVERDUE'))  AS legal_check,
    If(WildMatch(scenario_code, 'B*'),
       If(gap_vs_reference_days = 0, 'ON REQUESTED DATE',
          If(gap_vs_reference_days > 0, 'AFTER REFERENCE DATE', 'EARLY')))                         AS ppd_check,
    If(scenario_code <> 'X' AND actual_pub_date < earliest_pub_date, 1, 0)         AS anomaly_published_before_earliest;
LOAD *,
    Round(actual_pub_date - reception_ts, 0.001)                                   AS publication_delay_days,
    actual_pub_date - Floor(reception_ts)                                          AS publication_delay_calendar_days,
    Date(Floor(reception_ts) + $(vSLA_Days))                                       AS legal_deadline_date,
    If(scenario_code <> 'X', actual_pub_date - reference_pub_date)                 AS gap_vs_reference_days;
LOAD *,
    Date(If(scenario_code = 'A', earliest_pub_date,
         If(WildMatch(scenario_code, 'B*'), RangeMax(ppd_next_pub_date, earliest_pub_date))))  AS reference_pub_date,
    Pick(Match(scenario_code, 'A', 'B1', 'B2', 'B3', 'X'),
         'A - ASAP (no preferred date)',
         'B1 - Preferred date valid',
         'B2 - Preferred date shifted to next publication date',
         'B3 - Preferred date not achievable, earliest possible date applied',
         'X - Data issue')                                                         AS scenario_label;
LOAD *,
    If(IsNull(reception_ts) OR IsNull(actual_pub_date) OR IsNull(earliest_pub_date), 'X',
       If(has_ppd = 0, 'A',
          If(IsNull(ppd_requested_date) OR IsNull(ppd_next_pub_date), 'X',
             If(ppd_next_pub_date < earliest_pub_date, 'B3',
                If(ppd_is_pub_date = 0, 'B2', 'B1')))))                            AS scenario_code,
    If(IsNull(reception_ts), 'Reception date missing',
       If(IsNull(actual_pub_date), 'Publication date missing',
          If(IsNull(earliest_pub_date), 'No export found after reception',
             If(has_ppd = 1 AND IsNull(ppd_requested_date), 'Preferred date unreadable: ' & ppd_raw,
                If(has_ppd = 1 AND IsNull(ppd_next_pub_date), 'Preferred date beyond production calendar')))))  AS data_issue_reason
RESIDENT Notices_2;

DROP TABLE Notices_2;

///$tab 50_Manual Exceptions
// ---------------------------------------------------------------------
// Exceptions manuelles  au cas par cas des overdue et des faux negatifs
// Elles ne modifient JAMAIS la mesure du délai :
//   Corrections = yes -> statut final 'IN TIME (CORRECTED)'
//   Corrections = no  -> statut final 'OVERDUE - JUSTIFIED'
//
// => Cible : déplacer cette liste dans un fichier Excel/QVD maintenu par le métier
// ---------------------------------------------------------------------

ManualFixes:
LOAD
    business_notice_id_TM22 as business_notice_id,
    explanations,
    Corrections
INLINE
