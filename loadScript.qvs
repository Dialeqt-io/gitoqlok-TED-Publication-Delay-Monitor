///$tab 60_Statut final
LEFT JOIN (Notices_3)
LOAD * RESIDENT ManualFixes;

Notice:
NoConcatenate
LOAD *,
    If(final_status = 'TO CHECK', Null(), If(WildMatch(final_status, 'IN TIME*'), 1, 0)) AS is_compliant,
    
    // Status explanation
    scenario_label & ' | ' &
    If(scenario_code = 'A',
       'Received ' & Timestamp(reception_ts, 'DD/MM/YYYY hh:mm') & ' (' & reception_source & '), published '
       & Date(actual_pub_date, 'DD/MM/YYYY') & ': ' & publication_delay_calendar_days
       & ' calendar day(s), max ' & $(vSLA_Days) & ' -> ' & legal_check,
    If(WildMatch(scenario_code, 'B*'),
       'Requested ' & Date(ppd_requested_date, 'DD/MM/YYYY')
       & ', earliest possible ' & Date(earliest_pub_date, 'DD/MM/YYYY')
       & ', reference ' & Date(reference_pub_date, 'DD/MM/YYYY')
       & ', published ' & Date(actual_pub_date, 'DD/MM/YYYY') & ' -> ' & ppd_check
       & ' (real delay ' & publication_delay_calendar_days & ' calendar day(s))',
       'Data issue: ' & data_issue_reason))
    & If(late_inclusion_flag = 1, ' | Received during export, included in export of ' & Date(actual_pub_date, 'DD/MM/YYYY'))
    & If(Len(explanations) > 0, ' | Exception : ' & explanations)
                                                                                   AS rule_explanation;
    ;
LOAD *,
    If(scenario_code = 'X', 'TO CHECK',
       If(control_result_raw = 'IN TIME', 'IN TIME',
          If(Corrections = 'yes', 'IN TIME (CORRECTED)',
             If(Corrections = 'no', control_result_raw & ' - JUSTIFIED',
                control_result_raw))))                                             AS final_status,
    If(control_result_raw = 'IN TIME' AND Len(explanations) > 0, 1, 0)     		   AS exception_redundant,
    WeekDay(reception_ts, 0)                                                       AS reception_weekday,       // Mon..Sun, lundi = 1er jour
    Hour(reception_ts)                                                             AS reception_hour,
    If(WeekDay(reception_ts, 0) >= 5, 1, 0)                                        AS is_weekend_reception
RESIDENT Notices_3;

DROP TABLE Notices_3;

///$tab 70_Check QA
Tmp_Check:
LOAD
    Count(business_notice_id)                              AS n_rows,
    Count(DISTINCT business_notice_id)                     AS n_ids,
    Sum(If(scenario_code = 'X', 1, 0))                     AS n_to_check,
    Sum(If(reception_source = 'CHECK_IN_FALLBACK', 1, 0))  AS n_fallback,
    Sum(late_inclusion_flag)                                 AS n_late_inclusion,
    Sum(exception_redundant)                               AS n_exc_redundant,
    Sum(anomaly_published_before_earliest)                 AS n_before_earliest
RESIDENT Notice;

LET vRows = Peek('n_rows', 0, 'Tmp_Check');
LET vIds  = Peek('n_ids', 0, 'Tmp_Check');
TRACE >>> Avis : $(vRows) lignes / $(vIds) identifiants distincts (doivent être égaux);
LET vX = Peek('n_to_check', 0, 'Tmp_Check');        TRACE >>> TO CHECK (données insuffisantes) : $(vX);
LET vF = Peek('n_fallback', 0, 'Tmp_Check');        TRACE >>> Réception via check-in (fallback) : $(vF);
LET vR = Peek('n_late_inclusion', 0, 'Tmp_Check');    TRACE >>> Avis inclus en cours d export (late inclusion) : $(vR);
LET vE = Peek('n_exc_redundant', 0, 'Tmp_Check');   TRACE >>> Exceptions devenues inutiles : $(vE);
LET vB = Peek('n_before_earliest', 0, 'Tmp_Check'); TRACE >>> Publiés avant la 1re date possible (à analyser) : $(vB);
DROP TABLE Tmp_Check;

// Exceptions ne correspondant à aucun avis chargé
Exceptions_Unmatched:
NoConcatenate
LOAD business_notice_id AS exc_unmatched_id, explanations AS exc_unmatched_explanations
RESIDENT ManualFixes
WHERE NOT Exists(business_notice_id_TM22, business_notice_id);
DROP TABLE ManualFixes;

LET vU = NoOfRows('Exceptions_Unmatched'); TRACE >>> Exceptions sans avis correspondant : $(vU);

If $(vRows) <> $(vIds) THEN
    TRACE !!! ATTENTION : doublons d avis détectés - vérifier les jointures;
END IF

///$tab 80_Master calendar
// ---------------------------------------------------------------------
// Calendrier maître sur la date de publication effective (actual_pub_date)
// Semaines ISO (lundi, règle du jeudi), indépendantes de FirstWeekDay
// ---------------------------------------------------------------------
Tmp_CalRange:
LOAD Min(actual_pub_date) AS d_min, Max(actual_pub_date) AS d_max
RESIDENT Notice;
LET vPubMin = Num(Peek('d_min', 0, 'Tmp_CalRange'));
LET vPubMax = Num(Peek('d_max', 0, 'Tmp_CalRange'));
DROP TABLE Tmp_CalRange;

Publication_Calendar:
LOAD
    actual_pub_date,
    Year(actual_pub_date)                                                            AS [Publication Year],
    Dual(Year(actual_pub_date) & '-Q' & Ceil(Month(actual_pub_date) / 3),
         Year(actual_pub_date) * 10 + Ceil(Month(actual_pub_date) / 3))              AS [Publication Quarter],
    Month(actual_pub_date)                                                           AS [Publication Month],
    Date(MonthStart(actual_pub_date), 'MMM YYYY')                                    AS [Publication Year-Month],
    Week(actual_pub_date, 0, 0, 4)                                                   AS [Publication Week],
    Dual(WeekYear(actual_pub_date, 0, 0, 4) & '-W' & Num(Week(actual_pub_date, 0, 0, 4), '00'),
         Num(WeekStart(actual_pub_date, 0, 0)))                                      AS [Publication Year-Week],
    WeekDay(actual_pub_date, 0)                                                      AS [Publication Weekday]
;
LOAD Date($(vPubMin) + IterNo() - 1) AS actual_pub_date
AUTOGENERATE 1
WHILE $(vPubMin) + IterNo() - 1 <= $(vPubMax);

// Rattachement du calendrier de production : les infos d'export de chaque OJS
LEFT JOIN (Publication_Calendar)
LOAD
    plan_pub_date               AS actual_pub_date,
    1                           AS is_publication_day,
    plan_ojs_release_id,
    plan_release_count,
    plan_export_first_start,
    plan_export_last_start,
    plan_export_start_count,
    plan_exported_on
RESIDENT Production_Calendar;

DROP TABLE Production_Calendar;

///$tab 999_EXIT SCRIPT
exit script;