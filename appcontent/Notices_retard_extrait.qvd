	logged_on as real_reception_date_TM22, // heure rÃ©el de reception de chaque notice dans TM22, seul endroit correct
	notice_id as business_notice_id_TM22, // business ID pour faire les liens
	severity, 
	correlation_id, 
	version, 
	created_on, 
	modified_on, 
	created_by, 
	updated_by;[audit_log]:
SELECT `audit_log_id`,
	author,
	category,
	message,
	`logged_on`,
	`notice_id`,
	severity,
	`correlation_id`,
	version,
	`created_on`,
	`modified_on`,
	`created_by`,
	`updated_by`
FROM `tedmon22_database`.`audit_log`where category ='NOTICE_RECEIVED' </Statement>
     </LineageInfo>
     <LineageInfo>
       <Discriminator>OP_AWS_TEDMON22;</Discriminator>
       <Statement>LOAD ojs_release_id,
	exported_on as exported_on_full, // date and time fin de l'export
	publication_date as publication_date_full, //publication date
    publication_date as date_p;[ojs_release]:
SELECT ojs_release_id,
	exported_on,
	publication_date
FROM tedmon22_database.ojs_release</Statement>
     </LineageInfo>
     <LineageInfo>
       <Discriminator>OP_AWS_TEDMON22;</Discriminator>
       <Statement>LOAD ojs_release_id, 
	created_on, // date de debut d'export, probleme dans le cas de redemarrage, seule la premiere heure de demarrage est conservÃ©e alors qu en ca de redemarrage de nouvelles notices sont exportÃ©es car arrivÃ©es entre temps.
	Year(created_on) AS Year_export_start,
    // Calcul de la date de dÃ©but de l'heure d'Ã©tÃ© (dernier dimanche de mars)
    (MakeDate(Year(created_on), 3, 31) - WeekDay(MakeDate(Year(created_on), 3, 31))) AS export_DST_Start,
    // Calcul de la date de fin de l'heure d'Ã©tÃ© (dernier dimanche d'octobre)
    (MakeDate(Year(created_on), 10, 31) - WeekDay(MakeDate(Year(created_on), 10, 31))) AS export_DST_End,
    // DÃ©termination de l'heure d'Ã©tÃ© ou d'hiver
    If(
        created_on &gt;= (MakeDate(Year(created_on), 3, 31) - WeekDay(MakeDate(Year(created_on), 3, 31))) 
        and created_on &lt; (MakeDate(Year(created_on), 10, 31) - WeekDay(MakeDate(Year(created_on), 10, 31))), 
        'Heure d''Ã©tÃ©', 
        'Heure d''hiver'
    ) AS Heure_Ete_Hiver_export;[export_logs_int]:
SELECT 	`ojs_release_id`,
	`created_on`
FROM `tedmon22_database`.`export_logs`</Statement>
     </LineageInfo>
     <LineageInfo>
       <Discriminator>OP_AWS_TEDMON22;</Discriminator>
       <Statement>[audit_log]:
SELECT `audit_log_id`,
	author,
	category,
	message,
	`logged_on`,
	`notice_id`,
	severity,
	`correlation_id`,
	version,
	`created_on`,
	`modified_on`,
	`created_by`,
	`updated_by`
FROM `tedmon22_database`.`audit_log`where category ='NOTICE_RECEIVED' </Statement>
     </LineageInfo>
     <LineageInfo>
       <Discriminator>OP_AWS_TEDMON22;</Discriminator>
       <Statement>[export_logs_int]:
SELECT 	`ojs_release_id`,
	`created_on`
FROM `tedmon22_database`.`export_logs`</Statement>
     </LineageInfo>
